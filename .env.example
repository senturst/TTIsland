# ============================================================================
# 复制为 .env 后填写。留空也能跑——没有 Key 时游戏使用内置模板文本，功能不受影响。
# ============================================================================

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ---- AI 风味文本（可选）----
# 支持任何 OpenAI 兼容协议的服务商。默认 DeepSeek。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ENABLED=true

# ---- 成本控制硬上限 ----
# 日预算（分）。100 分约合 1 美元，稳态实际消耗远低于此。
LLM_DAILY_BUDGET_CENTS=100
LLM_MAX_CALLS_PER_DAY=3000

# ---- 本地开发 ----
# 生产环境保持 60；本地反复测试时可放宽
RATE_ACTION_PER_MIN=240

# ---- GitHub 推送（可选，仅 scripts/push_github.py 使用）----
# ⚠️ fine-grained token 默认是 "Public repositories (read-only)"，
#    即使仓库是你自己的，用它 push 也会 403 Permission denied。
#    必须在 token 设置里改为：
#      Repository access → Only select repositories → 勾选 TTIsland
#      Permissions → Repository permissions → Contents: Read and write
#    （或直接用 classic token 并勾选 repo 范围，更省事）
GITHUB_TOKEN=
